# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your-gemini-free-tier-key
GROQ_API_KEY=your-groq-free-tier-key
OLLAMA_BASE_URL=http://localhost:11434
# SEC asks for "Name email" as the User-Agent. Quote it because it has a space.
SEC_USER_AGENT="Your Name your.email@example.com"
# Optional: trace into Arize Phoenix (Phoenix 21 needs a system API key from its UI).
# Traces contain full prompts, questions and retrieved filing text, so point this only at
# a collector you trust (the local Phoenix from docker-compose.yml is the intended one).
# PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
# PHOENIX_API_KEY=
